#!/usr/bin/env bash
# Play the independent Kotlin edition with the existing Emberwood artwork.
# Keep this launcher and the Zed task current whenever this game changes.
set -euo pipefail
root=$(CDPATH="" cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd -- "$root"
build_only=false
offline=false
case ${1:-} in
    --help|-h)
        printf '%s\n' 'Emberwood Kotlin' 'Usage: ./emberwood-kotlin [--build | --offline] [game options]' \
            'First source launch downloads a private Java 25 and builds the game.' \
            'Later launches rebuild changed game sources automatically, including from Zed.' \
            'On macOS, a cached native app keeps source launches responsive and works offline.' \
            'Bundled application downloads need no Java, Gradle or developer tools.' \
            '  --build     prepare the game without opening a window' \
            '  --offline   use an existing build without downloading anything'
        exit 0 ;;
    --build) build_only=true; shift ;;
    --offline) offline=true; shift ;;
esac
if $build_only && (($#)); then printf '%s\n' '--build accepts no game arguments.' >&2; exit 2; fi
if $offline; then java_home=$(tools/bootstrap.sh --offline); else java_home=$(tools/bootstrap.sh); fi
export JAVA_HOME="$java_home"
jar=build/libs/emberwood-kotlin.jar
needs_build=false
[[ -f "$jar" ]] || needs_build=true
if [[ -f "$jar" ]] && [[ -n $(find src/main build.gradle.kts settings.gradle.kts gradle.properties VERSION -newer "$jar" -print -quit) ]]; then needs_build=true; fi
if $build_only || $needs_build; then
    if $offline; then printf '%s\n' 'No current game build is available. Run ./emberwood-kotlin --build online first.' >&2; exit 2; fi
    printf '%s\n' 'Building Emberwood Kotlin. Later launches run directly and work offline.' >&2
    ./gradlew --console=plain --no-daemon fatJar
fi
if $build_only; then
    if [[ $(uname -s) == Darwin ]]; then tools/source_mac_app.sh "$java_home" "$jar" >/dev/null; fi
    printf '%s\n' 'Ready. Open ./emberwood-kotlin to play.'
    exit 0
fi
if [[ $(uname -s) == Darwin && ( $# == 0 || ( $# == 2 && ${1:-} == --data-dir ) ) ]]; then
    # Keep argument errors, version output and genuine headless errors on the existing CLI.
    probe_status=0
    "$java_home/bin/java" "$root/tools/LauncherDesktopProbe.java" || probe_status=$?
    if ((probe_status != 0 && probe_status != 3)); then exit "$probe_status"; fi
    if ((probe_status == 0)); then
        app=$(tools/source_mac_app.sh "$java_home" "$jar")
        if (($# == 2)) && [[ $2 != /* ]]; then set -- --data-dir "$root/$2"; fi
        # LaunchServices owns the GUI process. Its exit status is not the app JVM's status.
        open_help=$(open -h 2>&1 || true)
        launch_status=0
        if [[ $open_help == *--stdout* && $open_help == *--stderr* ]]; then
            session=$(mktemp -d "${app%/*}/launch.XXXXXX")
            printf 'Native app logs: %s\n' "$session" >&2
            open -W -n --stdout "$session/stdout.log" --stderr "$session/stderr.log" "$app" --args "$@" || launch_status=$?
            [[ ! -s "$session/stdout.log" ]] || cat "$session/stdout.log"
            [[ ! -s "$session/stderr.log" ]] || cat "$session/stderr.log" >&2
        else
            open -W -n "$app" --args "$@" || launch_status=$?
        fi
        exit "$launch_status"
    fi
fi
if [[ $(uname -s) == Linux && ( $# == 0 || ( $# == 2 && ${1:-} == --data-dir ) ) ]]; then
    desktop_options=(--launch)
    if $offline; then desktop_options+=(--offline); fi
    tools/ensure_linux_desktop.sh "$java_home" "${desktop_options[@]}"
fi
exec "$java_home/bin/java" -Xms32m -Xmx256m --enable-native-access=ALL-UNNAMED -jar "$jar" "$@"
